<Window x:Class="Kworship.Desktop.DisplaySettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource AppWindow}" Title="Display setup" Width="690" Height="470" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
<DockPanel Margin="24"><StackPanel DockPanel.Dock="Bottom"><TextBlock x:Name="DisplayMessage" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="4,12" Text="Assignments are saved. Outputs reopen black and require confirmation. Reconnection never resumes live content automatically."/><WrapPanel HorizontalAlignment="Right"><Button Content="Identify screens" Click="Identify"/><Button Content="Cancel" IsCancel="True"/><Button x:Name="SaveDisplaysButton" Content="Save assignments" Style="{StaticResource AccentButton}" Click="SaveAssignments"/></WrapPanel></StackPanel>
<StackPanel><TextBlock Text="DISPLAY SETUP" FontSize="24" Margin="4,0,0,18"/><TextBlock Text="Congregation output" Margin="4,6"/><ComboBox x:Name="CongregationDisplay" MinWidth="500" AutomationProperties.Name="Congregation display"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="Stage / confidence output" Margin="4,18,4,6"/><ComboBox x:Name="StageDisplay" MinWidth="500" AutomationProperties.Name="Stage display"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="Use distinct physical displays for congregation and stage. A windowed output is available for preparing a service on one screen." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="4,18"/></StackPanel>
</DockPanel></Window>
