<Window x:Class="Kworship.Desktop.StructuredSongWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource AppWindow}" Title="Song sections and details" Width="980" Height="740" MinWidth="800" MinHeight="600" WindowStartupLocation="CenterOwner">
<DockPanel Margin="20">
 <StackPanel DockPanel.Dock="Top"><TextBlock Text="SONG SECTIONS &amp; DETAILS" FontSize="22" Margin="4,0,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Song title" Margin="4"/><TextBox x:Name="StructuredTitle" Text="{Binding Title,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Structured song title"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Author" Margin="4"/><TextBox x:Name="AuthorInput" Text="{Binding Author,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Song author"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Copyright / license credit" Margin="4"/><TextBox x:Name="CopyrightInput" Text="{Binding Copyright,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Copyright credit"/></StackPanel></Grid></StackPanel>
 <StackPanel DockPanel.Dock="Bottom"><TextBlock x:Name="EditorStatus" Text="Edit each section once. Add it to the play order as many times as needed; an empty order uses all sections." TextWrapping="Wrap" Margin="4,12" Foreground="{StaticResource MutedBrush}"/><WrapPanel HorizontalAlignment="Right"><Button Content="Cancel" IsCancel="True"/><Button x:Name="ApplyStructuredButton" Content="Apply to song editor" Style="{StaticResource AccentButton}" Click="ApplyChanges"/></WrapPanel></StackPanel>
 <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
 <Border Style="{StaticResource Panel}"><DockPanel><TextBlock DockPanel.Dock="Top" Text="SECTIONS" Style="{StaticResource Caption}"/><WrapPanel DockPanel.Dock="Bottom"><Button x:Name="AddVerseButton" Content="+ Verse" Click="AddVerse"/><Button x:Name="AddChorusButton" Content="+ Chorus" Click="AddChorus"/><Button Content="+ Bridge" Click="AddBridge"/><Button Content="Delete" Click="DeleteSection"/></WrapPanel><ListBox x:Name="SectionsList" ItemsSource="{Binding Sections}" AutomationProperties.Name="Song sections"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
 <GridSplitter Grid.Column="1"/>
 <Border Grid.Column="2" Style="{StaticResource Panel}"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Section label"/><TextBox x:Name="SectionLabelInput" Text="{Binding SelectedItem.Label,ElementName=SectionsList,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Section label"/><TextBlock Text="Section lyrics" Margin="4,12,0,4"/></StackPanel><TextBox x:Name="SectionBodyInput" Text="{Binding SelectedItem.Text,ElementName=SectionsList,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Section lyrics"/></DockPanel></Border>
 <GridSplitter Grid.Column="3"/>
 <Border Grid.Column="4" Style="{StaticResource Panel}"><DockPanel><TextBlock DockPanel.Dock="Top" Text="CUSTOM PLAY ORDER" Style="{StaticResource Caption}"/><StackPanel DockPanel.Dock="Bottom"><Button x:Name="AddOrderButton" Content="Add selected section →" Click="AddToOrder"/><WrapPanel><Button Content="↑" Click="OrderUp" AutomationProperties.Name="Move play-order entry up"/><Button Content="↓" Click="OrderDown" AutomationProperties.Name="Move play-order entry down"/><Button Content="Remove" Click="RemoveOrder"/></WrapPanel><Button Content="Use section order" Click="ClearOrder"/></StackPanel><ListBox x:Name="OrderList" ItemsSource="{Binding Order}" AutomationProperties.Name="Custom play order"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
 </Grid>
</DockPanel></Window>
