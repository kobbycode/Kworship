<Window x:Class="Kworship.Desktop.HymnImportWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource AppWindow}" Title="Import hymns" Width="900" Height="700" MinWidth="760" MinHeight="580" WindowStartupLocation="CenterOwner">
<DockPanel Margin="22">
 <StackPanel DockPanel.Dock="Top"><TextBlock Text="IMPORT HYMNS" FontSize="24" Margin="4,0,4,12"/><TextBlock Text="Choose a UTF-8 CSV or JSON collection you are authorised to project. Review it before importing. Existing songs are preserved; exact duplicates are skipped." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="4"/><WrapPanel><Button x:Name="ChooseHymnsButton" Content="Choose hymn file…" Click="ChooseFile"/><Button Content="Save example JSON…" Click="SaveExample"/></WrapPanel><TextBlock x:Name="ImportSummary" Text="No file selected. CSV requires title and lyrics columns. Optional: author, copyright, arrangement, hymnal, number." TextWrapping="Wrap" Margin="4,10"/></StackPanel>
 <StackPanel DockPanel.Dock="Bottom"><TextBlock x:Name="ImportMessage" Text="Blank lines separate slides. Labels such as [Verse 1] support custom arrangement. Hymnal and number are optional and appear in the library title." TextWrapping="Wrap" Margin="4,12" Foreground="{StaticResource MutedBrush}"/><WrapPanel HorizontalAlignment="Right"><Button Content="Cancel" IsCancel="True"/><Button x:Name="ConfirmHymnImportButton" Content="Import collection" Click="ConfirmImport" IsEnabled="False" Style="{StaticResource AccentButton}"/></WrapPanel></StackPanel>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><ListBox x:Name="HymnCandidates" SelectionChanged="SelectionChanged" AutomationProperties.Name="Hymns to import"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate></ListBox><Border Grid.Column="2" Background="#10242F" Padding="14" CornerRadius="5"><DockPanel><TextBlock x:Name="HymnCredit" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}"/><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="HymnPreview" Text="Select a file to review the hymns." TextWrapping="Wrap" FontSize="18"/></ScrollViewer></DockPanel></Border></Grid>
</DockPanel></Window>
