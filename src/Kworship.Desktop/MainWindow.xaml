<Window x:Class="Kworship.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Kworship · Worship workspace" Width="1440" Height="900" MinWidth="1120" MinHeight="720">
<Window.InputBindings><KeyBinding Key="S" Modifiers="Control" Command="{x:Static ApplicationCommands.Save}"/><KeyBinding Key="F" Modifiers="Control" Command="{x:Static ApplicationCommands.Find}"/></Window.InputBindings>
<Window.CommandBindings><CommandBinding Command="{x:Static ApplicationCommands.Save}" Executed="SaveFocused"/><CommandBinding Command="{x:Static ApplicationCommands.Find}" Executed="FocusSearch"/></Window.CommandBindings>
<DockPanel Margin="16">
 <Grid DockPanel.Dock="Top" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#245D91" CornerRadius="7" Padding="10,5"><TextBlock Text="K" FontSize="24" FontWeight="Bold"/></Border><StackPanel Margin="12,0"><TextBlock Text="KWORSHIP" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Prepare with confidence. Present with purpose." FontSize="12" Foreground="{StaticResource MutedBrush}"/></StackPanel></StackPanel>
  <WrapPanel Grid.Column="1"><Button Content="Congregation output ↗" Click="OpenOutput"/><Button Content="Stage output ↗" Click="OpenStage"/><Button Content="Back up library" Click="BackupLibrary"/></WrapPanel>
 </Grid>
 <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="10" Background="#192230" CornerRadius="5"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="LOCAL LIBRARY · TEXT PRESENTATION" Margin="18,0,0,0" Foreground="{StaticResource MutedBrush}" FontSize="11"/></Grid></Border>
 <Border DockPanel.Dock="Top" Visibility="{Binding HasRecovery, Converter={StaticResource BoolVisibility}}" Background="#41371E" CornerRadius="6" Padding="10" Margin="0,0,0,12"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Recover drafts" Click="Recover"/><Button Content="Dismiss" Click="DismissRecovery"/></StackPanel><TextBlock Text="Unsaved work was found. Recover it for review; outputs start black." VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel></Border>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="LibraryColumn" Width="250" MinWidth="200"/><ColumnDefinition Width="8"/><ColumnDefinition x:Name="ScheduleColumn" Width="270" MinWidth="230"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*" MinWidth="560"/></Grid.ColumnDefinitions>
  <Border Style="{StaticResource Panel}"><DockPanel>
   <StackPanel DockPanel.Dock="Top"><TextBlock Style="{StaticResource Caption}" Text="CONTENT LIBRARY / SONGS"/><TextBox x:Name="SearchBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search song titles and lyrics" ToolTip="Search titles and lyrics · Ctrl+F"/><WrapPanel Margin="0,6"><Button Content="+ New song" Click="NewSong"/><Button Content="Edit" Click="EditSelected"/></WrapPanel><TextBlock Text="Search titles and lyrics" Style="{StaticResource Caption}"/></StackPanel>
   <StackPanel DockPanel.Dock="Bottom"><Button Content="Preview selected" Click="PreviewLibrary"/><Button Content="Add to service →" Click="AddToService"/><TextBlock Text="Songs stay available offline. Add your own lyrics to get started." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="4,12"/></StackPanel>
   <ListBox x:Name="Songs" ItemsSource="{Binding Songs}" MouseDoubleClick="PreviewLibraryDoubleClick" AutomationProperties.Name="Song library"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Song" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
  </DockPanel></Border>
  <GridSplitter Grid.Column="1" DragCompleted="LayoutChanged"/>
  <Border Grid.Column="2" Style="{StaticResource Panel}"><DockPanel x:Name="ServicePanel">
   <StackPanel DockPanel.Dock="Top"><TextBlock Style="{StaticResource Caption}" Text="SERVICE SCHEDULE"/>
    <ComboBox x:Name="SavedSchedules" ItemsSource="{Binding Schedules}" DisplayMemberPath="Title" AutomationProperties.Name="Saved services" Margin="3" Padding="6" ToolTip="Choose a saved service, then Open"/>
    <WrapPanel><Button Content="Open" Click="OpenSchedule"/><Button Content="New" Click="NewSchedule"/><Button Content="Duplicate" Click="DuplicateSchedule"/></WrapPanel>
    <TextBox x:Name="ServiceTitleBox" Text="{Binding ScheduleTitle, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Service title"/>
    <TextBlock Text="{Binding ScheduleSaveLabel}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="4,6"/>
   </StackPanel>
   <StackPanel DockPanel.Dock="Bottom"><WrapPanel><Button Content="↑" AutomationProperties.Name="Move service item up" Click="MoveUp"/><Button Content="↓" AutomationProperties.Name="Move service item down" Click="MoveDown"/><Button Content="Remove" Click="RemoveEntry"/></WrapPanel><Button Content="Preview service item" Click="PreviewService"/><WrapPanel><Button Content="Save service" Style="{StaticResource AccentButton}" Click="SaveSchedule"/><Button Content="Discard edits" Click="DiscardSchedule"/></WrapPanel></StackPanel>
   <ListBox x:Name="ServiceItems" AllowDrop="True" PreviewMouseLeftButtonDown="StartServiceDrag" MouseMove="DragServiceItem" DragOver="ServiceDragOver" Drop="DropServiceItem" ItemsSource="{Binding Entries}" SelectedIndex="{Binding SelectedScheduleIndex}" MouseDoubleClick="PreviewServiceDoubleClick" AutomationProperties.Name="Service items"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="Song" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
  </DockPanel></Border>
  <GridSplitter Grid.Column="3" DragCompleted="LayoutChanged"/>
  <Grid Grid.Column="4"><Grid.RowDefinitions><RowDefinition x:Name="PreviewRow" Height="1.1*" MinHeight="300"/><RowDefinition Height="8"/><RowDefinition x:Name="EditorRow" Height="*" MinHeight="210"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Panel}" BorderBrush="#3E83B9" BorderThickness="1"><DockPanel>
     <StackPanel DockPanel.Dock="Top"><TextBlock Text="PREVIEW" Foreground="#63B3FF" FontWeight="SemiBold"/><TextBlock Text="{Binding PreviewTitle}" TextTrimming="CharacterEllipsis" Margin="0,8" FontSize="18"/></StackPanel>
     <StackPanel DockPanel.Dock="Bottom"><TextBlock Text="{Binding PreviewPosition}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,8"/><ListBox ItemsSource="{Binding PreviewSlides}" SelectedIndex="{Binding PreviewSlideIndex}" MaxHeight="76" AutomationProperties.Name="Preview slides"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" FontSize="12"/></DataTemplate></ListBox.ItemTemplate></ListBox><WrapPanel><Button Content="←" AutomationProperties.Name="Previous preview slide" Click="PreviewPrevious"/><Button Content="→" AutomationProperties.Name="Next preview slide" Click="PreviewNext"/><Button Content="Take →" Style="{StaticResource AccentButton}" Click="Take"/></WrapPanel></StackPanel>
     <Border Background="#10242F" CornerRadius="5" Padding="10"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" FontSize="19"/></ScrollViewer></Border>
    </DockPanel></Border>
    <Border Grid.Column="2" Style="{StaticResource Panel}" BorderBrush="#A14C5B" BorderThickness="1"><DockPanel>
     <StackPanel DockPanel.Dock="Top"><TextBlock Text="LIVE / CONGREGATION" Foreground="#FF8A9A" FontWeight="SemiBold"/><TextBlock Text="{Binding LiveTitle}" TextTrimming="CharacterEllipsis" Margin="0,8" FontSize="18"/></StackPanel>
     <StackPanel DockPanel.Dock="Bottom"><TextBlock Text="{Binding LivePosition}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,8"/><TextBlock Text="{Binding OutputStatus}" Foreground="#FFD166" FontSize="12" Margin="4,6"/><WrapPanel><Button Content="←" AutomationProperties.Name="Previous live slide" Click="LivePrevious"/><Button Content="→" AutomationProperties.Name="Next live slide" Click="LiveNext"/><Button Content="{Binding BlackLabel}" Click="Black" ToolTip="Toggle black screen"/><Button Content="{Binding ClearLabel}" Click="Clear" ToolTip="Hide text"/><Button Content="{Binding FreezeLabel}" Click="Freeze" ToolTip="Hold current visual while live advances"/></WrapPanel></StackPanel>
     <Border Background="Black" CornerRadius="5" Padding="10"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding LiveText}" TextWrapping="Wrap" TextAlignment="Center" FontSize="19"/></ScrollViewer></Border>
    </DockPanel></Border>
   </Grid>
   <GridSplitter Grid.Row="1" ResizeDirection="Rows" DragCompleted="LayoutChanged"/>
   <Border Grid.Row="2" Style="{StaticResource Panel}"><DockPanel x:Name="EditorPanel">
    <Grid DockPanel.Dock="Top"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="SONG EDITOR" Style="{StaticResource Caption}"/><TextBlock Grid.Column="1" Text="{Binding SongSaveLabel}" Foreground="{StaticResource MutedBrush}" FontSize="12"/></Grid>
    <TextBox DockPanel.Dock="Top" Text="{Binding SongTitle, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Song title" ToolTip="Song title"/>
    <WrapPanel DockPanel.Dock="Bottom"><Button Content="Save song" Style="{StaticResource AccentButton}" Click="SaveSong"/><Button Content="Discard edits" Click="DiscardSong"/><TextBlock Text="Blank lines separate slides · Labels: [Verse 1]" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="8,12"/></WrapPanel>
    <TextBox Text="{Binding Lyrics, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Song lyrics" FontSize="16"/>
   </DockPanel></Border>
  </Grid>
 </Grid>
</DockPanel>
</Window>
